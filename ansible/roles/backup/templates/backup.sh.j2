#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export AWS_DEFAULT_REGION='{{ aws_region }}'
export AWS_PAGER=''

umask 077

exec 9>/var/lock/container-db-backup.lock
flock -n 9 || {
  echo "Another backup is already running."
  exit 0
}

work="$(mktemp -d /var/backups/container-app/run.XXXXXX)"
trap 'rm -rf -- "$work"' EXIT

stamp="$(date -u +%Y%m%dT%H%M%S)-$$"

docker compose \
  --project-directory '{{ app_dir }}' \
  -p container-db \
  exec -T --user postgres postgres \
  pg_dump \
    -U '{{ db_user }}' \
    -d '{{ db_name }}' \
    --format=custom \
  > "$work/database.dump"

test -s "$work/database.dump"

(
  cd "$work"
  sha256sum database.dump > SHA256SUMS
)

tar -C "$work" \
  -czf "$work/backup.tar.gz" \
  database.dump SHA256SUMS

aws s3 cp \
  "$work/backup.tar.gz" \
  "s3://{{ backup_bucket }}/postgres/${stamp}.tar.gz" \
  --sse AES256 \
  --only-show-errors

printf '%s Backup uploaded: %s\n' \
  "$(date -u +%FT%TZ)" \
  "${stamp}.tar.gz"
